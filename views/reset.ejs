<% layout("layout") %>

    <div class="container register">

      <form class="form-signin" role="form" method="post" action="/reset/<%= token %>">
        <h2 class="form-signin-heading">Choose a new password</h2>
        <% if (message) { %>
          <p class="text-danger"><%= message %></p>
        <% } %>
        <input type="password" name="password" class="form-control" placeholder="New password" required autofocus minlength="6">
        <button class="btn btn-lg btn-primary btn-block" type="submit">Set new password</button>
      </form>

    </div>
